<?xml version="1.0" encoding="utf-8"?>
<!--
    The application page.

    It is laid out like the settings of a keyboard: a title, the test bench,
    and then the options in groups, every option with a line under it that
    says what it does.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:text="MangoKeys"
            android:textColor="?attr/appText"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="20dp"
            android:text="A Manglish keyboard that writes Malayalam."
            android:textColor="?attr/appFaint"
            android:textSize="14sp" />

        <!-- The test bench. -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/CardTitle"
                android:text="Try it" />

            <TextView
                style="@style/CardText"
                android:text="Type in the box. If MangoKeys is the keyboard that is on, the suggestions are above the keys." />

            <EditText
                android:id="@+id/field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field"
                android:gravity="top|start"
                android:hint="ente peru"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minHeight="88dp"
                android:padding="14dp"
                android:textColor="?attr/appText"
                android:textColorHint="?attr/appFaint"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card"
                android:padding="14dp"
                android:text="The Malayalam appears here"
                android:textColor="?attr/appFaint"
                android:textSize="18sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/examples"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- The options. -->
        <TextView
            style="@style/Section"
            android:text="Suggestions" />

        <LinearLayout style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/RowTitle"
                    android:text="Auto-convert on space" />

                <TextView
                    style="@style/RowSummary"
                    android:text="The space bar takes the best candidate and leaves the Malayalam in its place" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_auto_convert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/RowTitle"
                    android:text="Show suggestions" />

                <TextView
                    style="@style/RowSummary"
                    android:text="The candidates sit above the keys while a word is being typed" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_suggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/RowTitle"
                    android:text="Complete half typed words" />

                <TextView
                    style="@style/RowSummary"
                    android:text="A second model stops in the middle of a word and the word list finishes it" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_completion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/RowTitle"
                    android:text="Use the word list" />

                <TextView
                    style="@style/RowSummary"
                    android:text="The real Malayalam words around what the model guessed" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_word_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_beam"
            style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/RowTitle"
                    android:text="Candidates" />

                <TextView
                    style="@style/RowSummary"
                    android:text="How many candidates the search keeps for every word" />
            </LinearLayout>

            <TextView
                android:id="@+id/value_beam"
                style="@style/RowValue"
                android:text="4" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="Feedback" />

        <LinearLayout style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/RowTitle"
                    android:text="Haptics" />

                <TextView
                    style="@style/RowSummary"
                    android:text="A short vibration on every key" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_haptics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="Appearance" />

        <LinearLayout
            android:id="@+id/row_theme"
            style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/RowTitle"
                    android:text="Theme" />

                <TextView
                    style="@style/RowSummary"
                    android:text="Dark or light, for the keyboard and for this page" />
            </LinearLayout>

            <TextView
                android:id="@+id/value_theme"
                style="@style/RowValue"
                android:text="Dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_accent"
            style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/RowTitle"
                    android:text="Accent colour" />

                <TextView
                    style="@style/RowSummary"
                    android:text="The colour of the first candidate, the enter key and the selection" />
            </LinearLayout>

            <TextView
                android:id="@+id/value_accent"
                style="@style/RowValue"
                android:text="Ocean" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="About" />

        <LinearLayout
            android:id="@+id/row_about"
            style="@style/Row">

            <LinearLayout style="@style/RowText">

                <TextView
                    style="@style/RowTitle"
                    android:text="About MangoKeys" />

                <TextView
                    style="@style/RowSummary"
                    android:text="The models, the data and the licence" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/about_more"
                android:src="@drawable/ic_chevron" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
