<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MangoKeys"
            android:textColor="?attr/appText"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="A Manglish keyboard that writes Malayalam."
            android:textColor="?attr/appFaint"
            android:textSize="14sp" />

        <TextView
            style="@style/Section"
            android:layout_marginTop="24dp"
            android:text="Try it" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Type in the box below. If MangoKeys is the keyboard that is on, the suggestions are above the keys. The line under the box always shows what the word would become."
            android:textColor="?attr/appMuted"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/field"
            android:gravity="top|start"
            android:hint="ente peru"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minHeight="96dp"
            android:padding="14dp"
            android:textColor="?attr/appText"
            android:textColorHint="?attr/appFaint"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card"
            android:padding="14dp"
            android:text="…"
            android:textColor="?attr/appText"
            android:textSize="18sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/examples"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View style="@style/Divider" />

        <TextView
            style="@style/Section"
            android:text="Appearance" />

        <Switch
            android:id="@+id/switch_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Dark theme"
            android:textColor="?attr/appText"
            android:textSize="15sp" />

        <TextView
            style="@style/Label"
            android:text="Accent colour" />

        <LinearLayout
            android:id="@+id/accent_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/button_custom_accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/field"
            android:stateListAnimator="@null"
            android:text="Choose a custom colour"
            android:textAllCaps="false"
            android:textColor="?attr/appText"
            android:textSize="15sp" />

        <View style="@style/Divider" />

        <TextView
            style="@style/Section"
            android:text="Behaviour" />

        <Switch
            android:id="@+id/switch_completion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Complete half typed words"
            android:textColor="?attr/appText"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/switch_word_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Use the word list"
            android:textColor="?attr/appText"
            android:textSize="15sp" />

        <TextView
            style="@style/Label"
            android:text="Candidates" />

        <RadioGroup
            android:id="@+id/group_beam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/beam_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="?attr/appText" />

            <RadioButton
                android:id="@+id/beam_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="?attr/appText" />

            <RadioButton
                android:id="@+id/beam_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="?attr/appText" />
        </RadioGroup>

        <View style="@style/Divider" />

        <TextView
            style="@style/Section"
            android:text="About" />

        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="?attr/appMuted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:text="Nothing you type leaves the phone. The keyboard asks for no permissions at all."
            android:textColor="?attr/appFaint"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
